# Copy to .env and adjust. Never commit real values.

# Local PostgreSQL (docker-compose.yml)
POSTGRES_USER=forgedeck
POSTGRES_PASSWORD=change-me
POSTGRES_DB=forgedeck
FORGEDECK_POSTGRES_PORT=5432

# Control Plane
FORGEDECK_HTTP_ADDR=:8080
FORGEDECK_DATABASE_URL=postgres://forgedeck:change-me@localhost:5432/forgedeck?sslmode=disable
FORGEDECK_LOG_LEVEL=info
FORGEDECK_LOG_FORMAT=json
FORGEDECK_COOKIE_SECURE=false
# Encrypts stored credentials. Keep it outside the database and back it up:
# without it, stored Git tokens cannot be read. Generate: openssl rand -base64 32
# Rotation: put the new key first, keep old ones after it (id:key,id:key).
FORGEDECK_SECRET_KEYS=v1:REPLACE_WITH_BASE64_32_BYTES

# Integration tests: admin URL used to create throwaway databases
FORGEDECK_TEST_DATABASE_URL=postgres://forgedeck:change-me@localhost:5432/postgres?sslmode=disable

# Web UI dev server: where Vite forwards /api. Vite reads this from
# apps/web/.env.local, not from this file. Default: http://127.0.0.1:8080
# FORGEDECK_API_URL=http://127.0.0.1:8080
