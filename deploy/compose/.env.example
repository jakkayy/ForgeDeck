# Copy to .env (next to docker-compose.yml) and fill in. Never commit .env.

# Public DNS name of this host; ports 80 and 443 must reach it (Caddy certificate)
FORGEDECK_DOMAIN=forgedeck.example.com

# PostgreSQL password, letters and digits only (used in a URL): openssl rand -hex 24
POSTGRES_PASSWORD=

# Encrypts stored secrets, not in backups; keep a copy away from this host: echo "v1:$(openssl rand -base64 32)"
FORGEDECK_SECRET_KEYS=

# Optional

# The release to run, such as v0.1.0 (default: latest). It is also the version shown in the dashboard.
# FORGEDECK_VERSION=

# Build the image from this checkout instead of pulling it (before the first release, or for local changes).
# COMPOSE_FILE=docker-compose.yml:docker-compose.build.yml

# Only to try the stack on a machine where 80/443 are taken (see README.md).
# FORGEDECK_HTTP_PORT=8080
# FORGEDECK_HTTPS_PORT=8443
# FORGEDECK_PUBLIC_URL=https://localhost:8443

# GitHub App (docs/13-git-providers.md). The private key is the PEM text itself.
# FORGEDECK_GITHUB_APP_ID=
# FORGEDECK_GITHUB_APP_SLUG=
# FORGEDECK_GITHUB_CLIENT_ID=
# FORGEDECK_GITHUB_CLIENT_SECRET=
# FORGEDECK_GITHUB_APP_PRIVATE_KEY=
# FORGEDECK_GITHUB_WEBHOOK_SECRET=

# Set true if ForgeDeck is internet-reachable before the first sign-in; use `docker compose exec api /forgedeck-api create-user`
# FORGEDECK_DISABLE_WEB_SETUP=true

# A self-hosted GitLab on a private network (see docs/07-security.md before enabling).
# FORGEDECK_ALLOW_PRIVATE_GIT_HOSTS=true

# Retention in days; 0 keeps forever (docs/03-database.md).
# FORGEDECK_RETENTION_JOB_LOGS_DAYS=30
# FORGEDECK_RETENTION_JOBS_DAYS=180
# FORGEDECK_RETENTION_WEBHOOKS_DAYS=30
# FORGEDECK_RETENTION_AUDIT_DAYS=365
