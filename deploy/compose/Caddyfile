# Terminates TLS; Caddy gets certificates itself (localhost uses its local CA).
{$FORGEDECK_DOMAIN} {
	encode zstd gzip

	reverse_proxy api:8080 {
		# SSE job logs must not be buffered
		flush_interval -1
		transport http {
			# agents and runners long-poll for up to 25 seconds
			response_header_timeout 60s
		}
	}

	# the application sets the security headers
	header -Server

	log {
		output stdout
		format json
	}
}
