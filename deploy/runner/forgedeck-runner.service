[Unit]
Description=ForgeDeck build Runner
Documentation=https://github.com/jakkayy/ForgeDeck/blob/main/docs/14-runner.md
After=network-online.target
Wants=network-online.target

[Service]
User=forgedeck-runner
Group=forgedeck-runner
EnvironmentFile=/etc/forgedeck-runner/runner.env
# install.sh adds DOCKER_HOST (the user's rootless Docker socket) to runner.env
ExecStart=/usr/local/bin/forgedeck-runner run \
    --url ${FORGEDECK_URL} \
    --work-dir /var/lib/forgedeck-runner \
    --build-timeout ${FORGEDECK_BUILD_TIMEOUT} \
    --test-cpus ${FORGEDECK_TEST_CPUS} \
    --test-memory ${FORGEDECK_TEST_MEMORY} \
    --test-pids ${FORGEDECK_TEST_PIDS}
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s

StateDirectory=forgedeck-runner
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# read-only, not true: true hides /run/user, where the rootless Docker socket is
ProtectHome=read-only
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
