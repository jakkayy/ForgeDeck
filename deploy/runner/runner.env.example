# Copy to /etc/forgedeck-runner/runner.env (root:forgedeck-runner, mode 0640).
FORGEDECK_URL=https://forgedeck.example.com
# Printed once by `forgedeck-api create-runner --name build-01`.
FORGEDECK_RUNNER_CREDENTIAL=fdr_REPLACE_ME
FORGEDECK_BUILD_TIMEOUT=20m
FORGEDECK_TEST_CPUS=2
FORGEDECK_TEST_MEMORY=2g
FORGEDECK_TEST_PIDS=512
